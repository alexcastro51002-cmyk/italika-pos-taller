#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
first_line=$(head -n 1 "$msg_file" | tr -d '\r')

if [[ ! "$first_line" =~ ^(feat|fix|chore|docs|refactor|test|ci|build|perf)(\([a-z0-9-]+\))?!?:[[:space:]].{3,} ]]; then
  echo "ERROR: El mensaje de commit debe seguir Conventional Commits."
  echo "Ejemplo: feat(catalog): add service status filter"
  echo "Recibido: $first_line"
  exit 1
fi
